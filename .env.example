# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# NOTE: every VITE_* variable is embedded in the public client bundle — never put private secrets here.

# EmailJS (contact form) — https://www.emailjs.com/
# Template parameters used by the form: user_name, user_email, subject, message
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Analytics (optional)
VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false
